                  "language": "json"
                }
              }
            },
            "description": "Upload the PDF to the returned form before submitting."
          }
        },
        {
          "name": "Submit a print job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Partner-Key",
                "value": "{{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/print-jobs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "print-jobs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_id\": \"batch-2026-09-25\",\n  \"booklet_count\": 120,\n  \"pages_per_booklet\": 8\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "order_id",
      "value": ""
    },
    {
      "key": "create_key",
      "value": ""
    },
    {
      "key": "upload_key",
      "value": ""
    }
  ]
}